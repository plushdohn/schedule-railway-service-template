# Set these on start-target; stop-target inherits them through Railway references.
# IDs identify the EXISTING TARGET, not this Function.
TARGET_SERVICE_ID=
TARGET_ENVIRONMENT_ID=
# Project Token scoped to the target project and environment.
RAILWAY_PROJECT_TOKEN=

# Optional local build-time overrides; schedules are always UTC.
# START_CRON_SCHEDULE=0 8 * * 1-5
# STOP_CRON_SCHEDULE=0 18 * * 1-5

# Maintainer-only optional template registration credentials (not runtime auth).
# RAILWAY_API_TOKEN=
# RAILWAY_WORKSPACE_ID=
