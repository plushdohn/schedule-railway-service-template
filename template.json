{
  "buckets": {},
  "services": {
    "4fa8a608-38c8-41b3-a498-26d44c8820fc": {
      "name": "start-target",
      "source": {
        "image": "ghcr.io/railwayapp/function-bun:1.4.0"
      },
      "deploy": {
        "startCommand": "./run.sh ",
        "cronSchedule": "0 8 * * *",
        "restartPolicyType": "NEVER"
      },
      "variables": {
        "TARGET_SERVICE_ID": {
          "isOptional": false,
          "description": "UUID of the existing service to control (not this Function)",
          "defaultValue": ""
        },
        "TARGET_ENVIRONMENT_ID": {
          "isOptional": false,
          "description": "UUID of the target service's environment",
          "defaultValue": ""
        },
        "RAILWAY_PROJECT_TOKEN": {
          "isOptional": false,
          "description": "Railway Project Token scoped to the target project's environment",
          "defaultValue": ""
        }
      }
    },
    "140b2fe9-4ce6-4964-aa92-51f0482e0a0f": {
      "name": "stop-target",
      "source": {
        "image": "ghcr.io/railwayapp/function-bun:1.4.0"
      },
      "deploy": {
        "startCommand": "./run.sh ",
        "cronSchedule": "0 23 * * *",
        "restartPolicyType": "NEVER"
      },
      "variables": {
        "TARGET_SERVICE_ID": {
          "isOptional": false,
          "description": "UUID of the existing service to control (not this Function)",
          "defaultValue": "${{start-target.TARGET_SERVICE_ID}}"
        },
        "TARGET_ENVIRONMENT_ID": {
          "isOptional": false,
          "description": "UUID of the target service's environment",
          "defaultValue": "${{start-target.TARGET_ENVIRONMENT_ID}}"
        },
        "RAILWAY_PROJECT_TOKEN": {
          "isOptional": false,
          "description": "Railway Project Token scoped to the target project's environment",
          "defaultValue": "${{start-target.RAILWAY_PROJECT_TOKEN}}"
        }
      }
    }
  }
}
